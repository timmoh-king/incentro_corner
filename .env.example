# The board that stores the thank-you notes. Find the number in the board URL.
VITE_KUDOS_BOARD_ID=

# Optional. Powers the HeyTaco leaderboard panel in TV mode (see README "TV
# mode"). Get a key from HeyTaco: Profile -> API keys. Leave blank to show
# sample standings instead of a real board.
VITE_HEYTACO_API_KEY=

# TV mode cycles through all three leaderboard types (given, received,
# combined) automatically, so there's no type to set here.

# today | week | month | year | alltime — applies to the given/received
# leaderboards. "combined" ignores this and always uses alltime, because
# HeyTaco's API rejects type=combined with anything shorter than a year.
VITE_HEYTACO_LEADERBOARD_TIMEFRAME=week

# Optional. Lets the app authenticate with monday's API outside monday's
# iframe — local dev (npm run dev) and the ?tv=1 display both run standalone,
# so without this they fall back to sample people/notes. Get one from your
# monday profile (Admin -> API), needs at least users:read and boards:read.
# Leave blank to keep using sample data outside monday.
VITE_MONDAY_API_TOKEN=
